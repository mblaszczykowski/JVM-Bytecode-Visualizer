<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.jvmvisualizer</groupId>
  <artifactId>compile-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>compile-service</name>
  <description>In-memory Java compile service for the JVM Bytecode Visualizer</description>

  <properties>
    <java.version>21</java.version>
    <!-- Built and tested on newer JDKs as well; the produced bytecode stays on the Java 21 LTS baseline. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Security fixes newer than the Spring Boot BOM. -->
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <tomcat.version>11.0.25</tomcat.version>
    <!-- Surefire appends to this; declaring it empty keeps @{argLine} resolvable without JaCoCo. -->
    <argLine/>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Bounded, expiring store for the per-IP rate limit counters. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Mockito arrives with spring-boot-starter-test and self-attaches its agent. The
               @{argLine} prefix is resolved late, so an agent-setting plugin (JaCoCo) can prepend
               to it without this line knowing about it. -->
          <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
      </plugin>

      <!-- Coverage gate on the code an attacker reaches first: the compiler sandbox, the filters
           in front of it, and the handler that decides what an error response says. The agent
           line is prepended to surefire's @{argLine}. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <!-- Pinned because the parent POM does not manage JaCoCo, and a coverage gate whose
             version drifts with the newest release available is not a gate. -->
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-security-critical-packages</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <!-- Check each security-facing package independently. The forked child JVM is
                     not instrumented by the coverage agent. -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>dev.jvmvisualizer.compileservice.api</include>
                    <include>dev.jvmvisualizer.compileservice.compiler</include>
                    <include>dev.jvmvisualizer.compileservice.config</include>
                    <include>dev.jvmvisualizer.compileservice.service</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
