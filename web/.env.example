# Base URL of the compile service. Leave it unset and the Java editor never appears — the
# examples and .class uploads work without any backend.
VITE_COMPILE_API_URL=http://localhost:8080

# Where crash reports go. Unset — the default everywhere including local development — nothing
# is ever sent. What is sent carries the shape of a failure and never the reader's code: see
# the closed `Report` union in web/src/services/telemetry.ts.
# VITE_TELEMETRY_URL=https://telemetry.example/report
